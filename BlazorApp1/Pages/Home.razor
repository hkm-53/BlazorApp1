@page "/"
@using ClosedXML.Excel
@using System.Text.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager NavManager

<h3>Erfassung Energie (Tagesdaten)</h3>

<div class="p-3 mb-3 border rounded bg-light">
    <h5>Google Drive Verbindung</h5>

    @if (string.IsNullOrEmpty(googleToken))
    {
        <a href="@GeneriereGoogleAuthUrl()" class="btn btn-success btn-lg w-100">
            1. Mit Google Drive verbinden
        </a>
    }
    else
    {
        <button class="btn btn-primary w-100" @onclick="LadeVonGoogleDrive">
            Datei aus Google Drive neu laden
        </button>
    }

    @if (!string.IsNullOrEmpty(statusText))
    {
        <div class="alert alert-info mt-3" style="word-break: break-all;">@statusText</div>
    }
</div>

<div class="mb-3">
    <label class="form-label small text-muted">Alternativ lokale Datei (Notfall / Test):</label>
    <InputFile OnChange="ExcelLaden" accept=".xlsx" class="form-control" />
</div>

@if (alleZeilen.Count > 0)
{
    <div class="mb-3 p-2 bg-light border rounded">
        <label class="form-label fw-bold">Datensatz / Tag auswählen (aktuell Zeile @aktuelleZeile):</label>
        <select class="form-select" @onchange="ZeileWechseln">
            @foreach (var zeile in alleZeilen)
            {
                <option value="@zeile.ZeilenNummer" selected="@(zeile.ZeilenNummer == aktuelleZeile)">
                    Zeile @zeile.ZeilenNummer: @zeile.AnzeigeText
                </option>
            }
        </select>
    </div>

    @for (int i = 0; i < felder.Count; i++)
    {
        var index = i;
        <div class="mb-3">
            <label class="form-label fw-bold">@felder[index].SpaltenName</label>
            <input type="text" class="form-control" @bind="felder[index].Wert" />
        </div>
    }

    <button class="btn btn-primary btn-lg w-100 mb-5" @onclick="SpeichernAufGoogleDrive">
        @(string.IsNullOrEmpty(aktuelleDriveDateiId) ? $"Lokal speichern ({GeneriereZielDateiname()})" : $"In Google Drive überschreiben ({geladenerDateiName})")
    </button>
}

@code {
    private const string ClientNummer = "532480087224-7cv3n70c8jechg9gnn57asvc0hesdvm9";
    private string statusText = "";
    private string? googleToken = null;
    private string? aktuelleDriveDateiId = null;
    private string geladenerDateiName = "Erf_Energie_2611.xlsx";

    class FeldItem
    {
        public int SpaltenNummer { get; set; }
        public string SpaltenName { get; set; } = "";
        public string Wert { get; set; } = "";
    }

    class ZeilenInfo
    {
        public int ZeilenNummer { get; set; }
        public string AnzeigeText { get; set; } = "";
    }

    private List<FeldItem> felder = new();
    private List<ZeilenInfo> alleZeilen = new();
    private byte[]? originalDateiBytes;
    private int aktuelleZeile = 3;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavManager.Uri);
        if (!string.IsNullOrEmpty(uri.Fragment) && uri.Fragment.Contains("access_token="))
        {
            var parts = uri.Fragment.TrimStart('#').Split('&');
            foreach (var part in parts)
            {
                if (part.StartsWith("access_token="))
                {
                    googleToken = Uri.UnescapeDataString(part.Substring("access_token=".Length));
                    break;
                }
            }

            if (!string.IsNullOrEmpty(googleToken))
            {
                await LadeVonGoogleDrive();
            }
        }
    }

    private string GeneriereGoogleAuthUrl()
    {
        string volleClientId = ClientNummer + ".apps.googleusercontent.com";
        string authBasis = "https:" + "//accounts." + "google.com" + "/o/oauth2/v2/auth";
        string zielSeite = "https:" + "//hkm-53." + "github.io" + "/BlazorApp1/";
        string bereich = "https:" + "//www." + "googleapis.com" + "/auth/drive";

        return authBasis +
               "?client_id=" + Uri.EscapeDataString(volleClientId) +
               "&redirect_uri=" + Uri.EscapeDataString(zielSeite) +
               "&response_type=token" +
               "&scope=" + Uri.EscapeDataString(bereich);
    }

    private async Task LadeVonGoogleDrive()
    {
        if (string.IsNullOrEmpty(googleToken)) return;

        try
        {
            statusText = "Suche und lade Erf_Energie_2611.xlsx aus Google Drive...";

            string suchUrl = "https:" + "//www." + "googleapis.com" + "/drive/v3/files?q=name%20contains%20'Erf_Energie_2611'%20and%20trashed%3Dfalse&fields=files(id,name)";
            var suchReq = new HttpRequestMessage(HttpMethod.Get, suchUrl);
            suchReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", googleToken);
            var suchRes = await Http.SendAsync(suchReq);
            string json = await suchRes.Content.ReadAsStringAsync();

            using var doc = JsonDocument.Parse(json);
            var files = doc.RootElement.GetProperty("files");
            if (files.GetArrayLength() == 0)
            {
                statusText = "Datei Erf_Energie_2611 wurde auf Google Drive nicht gefunden.";
                return;
            }

            aktuelleDriveDateiId = files[0].GetProperty("id").GetString();
            geladenerDateiName = files[0].GetProperty("name").GetString() ?? "Erf_Energie_2611.xlsx";

            string downloadUrl = "https:" + "//www." + "googleapis.com" + $"/drive/v3/files/{aktuelleDriveDateiId}?alt=media";
            var dlReq = new HttpRequestMessage(HttpMethod.Get, downloadUrl);
            dlReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", googleToken);
            var dlRes = await Http.SendAsync(dlReq);

            if (!dlRes.IsSuccessStatusCode)
            {
                statusText = $"Fehler beim Herunterladen: {dlRes.StatusCode}";
                return;
            }

            originalDateiBytes = await dlRes.Content.ReadAsByteArrayAsync();
            ExcelInMaskeLaden(originalDateiBytes);
            statusText = $"Geladen: {geladenerDateiName} (bitte oben gewünschten Datensatz wählen)";
        }
        catch (Exception ex)
        {
            statusText = $"Fehler beim Laden: {ex.Message}";
        }
    }

    private async Task ExcelLaden(InputFileChangeEventArgs e)
    {
        aktuelleDriveDateiId = null;
        geladenerDateiName = e.File.Name;
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
        originalDateiBytes = ms.ToArray();
        ExcelInMaskeLaden(originalDateiBytes);
    }

    private void ExcelInMaskeLaden(byte[] daten)
    {
        using var ms = new MemoryStream(daten);
        using var workbook = new XLWorkbook(ms);
        var sheet = workbook.Worksheet(1);

        alleZeilen.Clear();
        int letzteZeile = sheet.LastRowUsed()?.RowNumber() ?? 3;
        string heuteText = DateTime.Now.ToString("dd.MM.yyyy");
        aktuelleZeile = 3;

        // Startet erst ab Zeile 3 (Zeile 1 = Überschrift, Zeile 2 = Vormonat)
        for (int row = 3; row <= letzteZeile; row++)
        {
            string spalte1 = sheet.Cell(row, 1).GetString();
            string spalte2 = sheet.Cell(row, 2).GetString();
            string anzeige = $"{spalte1} {spalte2}".Trim();
            if (string.IsNullOrEmpty(anzeige)) anzeige = "(Leer)";

            alleZeilen.Add(new ZeilenInfo { ZeilenNummer = row, AnzeigeText = anzeige });

            if (spalte1.Contains(heuteText))
            {
                aktuelleZeile = row;
            }
        }

        LadeZeilenFelder(sheet, aktuelleZeile);
    }

    private void ZeileWechseln(ChangeEventArgs e)
    {
        if (originalDateiBytes == null || !int.TryParse(e.Value?.ToString(), out int gewaehlteZeile)) return;

        aktuelleZeile = gewaehlteZeile;
        using var ms = new MemoryStream(originalDateiBytes);
        using var workbook = new XLWorkbook(ms);
        LadeZeilenFelder(workbook.Worksheet(1), aktuelleZeile);
    }

    private void LadeZeilenFelder(IXLWorksheet sheet, int zeile)
    {
        felder.Clear();
        int letzteSpalte = sheet.Row(1).LastCellUsed()?.Address.ColumnNumber ?? 0;

        for (int col = 1; col <= letzteSpalte; col++)
        {
            felder.Add(new FeldItem
            {
                SpaltenNummer = col,
                SpaltenName = sheet.Cell(1, col).GetString(),
                Wert = sheet.Cell(zeile, col).GetString()
            });
        }
    }

    private string GeneriereZielDateiname() => $"Erf_Energie_{DateTime.Now:yyMMdd}.xlsx";

    private async Task SpeichernAufGoogleDrive()
    {
        if (originalDateiBytes == null) return;

        using var ms = new MemoryStream(originalDateiBytes);
        using var workbook = new XLWorkbook(ms);
        var sheet = workbook.Worksheet(1);

        foreach (var feld in felder)
        {
            sheet.Cell(aktuelleZeile, feld.SpaltenNummer).Value = feld.Wert;
        }

        using var outStream = new MemoryStream();
        workbook.SaveAs(outStream);
        originalDateiBytes = outStream.ToArray();

        if (!string.IsNullOrEmpty(googleToken) && !string.IsNullOrEmpty(aktuelleDriveDateiId))
        {
            try
            {
                statusText = "Speichere direkt auf Google Drive...";
                string uploadUrl = "https:" + "//www." + "googleapis.com" + $"/upload/drive/v3/files/{aktuelleDriveDateiId}?uploadType=media";
                var upReq = new HttpRequestMessage(HttpMethod.Patch, uploadUrl);
                upReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", googleToken);
                upReq.Content = new ByteArrayContent(originalDateiBytes);
                upReq.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

                var upRes = await Http.SendAsync(upReq);
                if (upRes.IsSuccessStatusCode)
                {
                    statusText = $"ERFOLG! Zeile {aktuelleZeile} wurde direkt in {geladenerDateiName} auf Google Drive überschrieben.";
                    return;
                }
                else
                {
                    statusText = $"Google Drive Fehler ({upRes.StatusCode}) – starte lokalen Notfall-Download...";
                }
            }
            catch (Exception ex)
            {
                statusText = $"Verbindungsfehler ({ex.Message}) – starte lokalen Notfall-Download...";
            }
        }

        outStream.Position = 0;
        using var streamRef = new DotNetStreamReference(outStream);
        await JS.InvokeVoidAsync("downloadFileFromStream", GeneriereZielDateiname(), streamRef);
    }
}
