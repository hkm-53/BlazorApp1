@page "/"
@using BlazorApp1.Models
@using BlazorApp1.Services
@using ClosedXML.Excel
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject GoogleDriveService DriveService
@inject ExcelService ExcelSvc

<h3>Erfassung Energie (Tagesdaten)</h3>

<div class="p-3 mb-3 border rounded bg-light">
    <h5>Google Drive Verbindung</h5>

    @if (string.IsNullOrEmpty(googleToken))
    {
        <a href="@DriveService.GeneriereGoogleAuthUrl()" class="btn btn-success btn-lg w-100">
            1. Mit Google Drive verbinden
        </a>
    }
    else
    {
        <button class="btn btn-primary w-100" @onclick="LadeVonGoogleDrive">
            Datei aus Google Drive neu laden
        </button>
    }

    @if (!string.IsNullOrEmpty(statusText))
    {
        <div class="alert alert-info mt-3" style="word-break: break-all;">@statusText</div>
    }
</div>

<div class="mb-3">
    <label class="form-label small text-muted">Alternativ lokale Datei (Notfall / Test):</label>
    <InputFile OnChange="LokaleDateiLaden" accept=".xlsx" class="form-control" />
</div>

@if (alleZeilen.Count > 0)
{
    <div class="mb-3 p-2 bg-light border rounded">
        <label class="form-label fw-bold">Datensatz / Tag auswählen (Zeile @aktuelleZeile):</label>
        <select class="form-select" @onchange="ZeileWechseln">
            @foreach (var zeile in alleZeilen)
            {
                <option value="@zeile.ZeilenNummer" selected="@(zeile.ZeilenNummer == aktuelleZeile)">
                    Zeile @zeile.ZeilenNummer: @zeile.AnzeigeText
                </option>
            }
        </select>
    </div>

    @for (int i = 0; i < felder.Count; i++)
    {
        var index = i;
        var feld = felder[index];

        <div class="mb-3">
            <label class="form-label fw-bold">
                @feld.AnzeigeLabel
                @if (feld.IstFormel)
                {
                    <span class="badge bg-secondary ms-2">Formel (schreibgeschützt)</span>
                }
            </label>

            @if (feld.IstFormel)
            {
                <input type="text" class="form-control bg-light text-muted" value="@feld.Wert" readonly />
            }
            else if (feld.Typ.Equals("Kombifeld", StringComparison.OrdinalIgnoreCase))
            {
                <select class="form-select" @bind="felder[index].Wert">
                    <option value="">-- Bitte wählen --</option>
                    @foreach (var opt in feld.KombiOptionen)
                    {
                        <option value="@opt.Wert">@opt.AnzeigeText</option>
                    }
                </select>
            }
            else if (feld.Typ.Equals("DatumAusw", StringComparison.OrdinalIgnoreCase))
            {
                <input type="date" class="form-control" value="@feld.Wert"
                       @onchange="@(e => felder[index].Wert = e.Value?.ToString() ?? "")" />
            }
            else if (feld.Typ.Equals("ZeitAusw", StringComparison.OrdinalIgnoreCase))
            {
                <input type="time" class="form-control" value="@feld.Wert"
                       @onchange="@(e => felder[index].Wert = e.Value?.ToString() ?? "")" />
            }
            else if (feld.Typ.Equals("Memo", StringComparison.OrdinalIgnoreCase))
            {
                <textarea class="form-control" rows="3" @bind="felder[index].Wert"></textarea>
            }
            else
            {
                <input type="text" class="form-control" @bind="felder[index].Wert" />
            }
        </div>
    }

    <button class="btn btn-primary btn-lg w-100 mb-5" @onclick="Speichern">
        @(string.IsNullOrEmpty(aktuelleDriveDateiId)
            ? $"Lokal speichern ({GeneriereZielDateiname()})"
            : $"In Google Drive überschreiben ({geladenerDateiName})")
    </button>
}

@code {
    private string statusText = "";
    private string? googleToken = null;
    private string? aktuelleDriveDateiId = null;
    private string geladenerDateiName = "Erf_Energie_2611.xlsx";
    private string aktuellesBlattName = "Erfassung";

    private byte[]? originalDateiBytes;
    private ExcelSteuerungDaten steuerung = new();
    private List<ZeilenInfo> alleZeilen = new();
    private List<FeldItem> felder = new();
    private int aktuelleZeile = 3;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavManager.Uri);
        if (!string.IsNullOrEmpty(uri.Fragment) && uri.Fragment.Contains("access_token="))
        {
            var parts = uri.Fragment.TrimStart('#').Split('&');
            foreach (var part in parts)
            {
                if (part.StartsWith("access_token="))
                {
                    googleToken = Uri.UnescapeDataString(part.Substring("access_token=".Length));
                    break;
                }
            }

            if (!string.IsNullOrEmpty(googleToken))
            {
                await LadeVonGoogleDrive();
            }
        }
    }

    private async Task LadeVonGoogleDrive()
    {
        if (string.IsNullOrEmpty(googleToken)) return;

        statusText = "Suche und lade Erf_Energie_2611.xlsx aus Google Drive...";
        var ergebnis = await DriveService.LadeExakteDateiAsync(googleToken, "Erf_Energie_2611.xlsx");

        if (ergebnis.Bytes == null)
        {
            statusText = ergebnis.Fehler ?? "Unbekannter Fehler beim Laden.";
            return;
        }

        aktuelleDriveDateiId = ergebnis.DateiId;
        geladenerDateiName = ergebnis.DateiName;
        originalDateiBytes = ergebnis.Bytes;

        VerarbeiteExcelBytes(originalDateiBytes);
        statusText = $"Geladen: {geladenerDateiName} (Blatt: {aktuellesBlattName}, Zeile {aktuelleZeile})";
    }

    private async Task LokaleDateiLaden(InputFileChangeEventArgs e)
    {
        aktuelleDriveDateiId = null;
        geladenerDateiName = e.File.Name;
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
        originalDateiBytes = ms.ToArray();

        VerarbeiteExcelBytes(originalDateiBytes);
    }

    private void VerarbeiteExcelBytes(byte[] daten)
    {
        using var ms = new MemoryStream(daten);
        using var workbook = new XLWorkbook(ms);

        steuerung = ExcelSvc.LeseSteuerung(workbook);
        var sheet = ExcelSvc.GetArbeitsblatt(workbook, "Erfassung");
        aktuellesBlattName = sheet.Name;

        alleZeilen = ExcelSvc.LeseZeilenListe(sheet, steuerung, out aktuelleZeile);
        felder = ExcelSvc.LeseZeilenFelder(sheet, aktuelleZeile, steuerung);
    }

    private void ZeileWechseln(ChangeEventArgs e)
    {
        if (originalDateiBytes == null || !int.TryParse(e.Value?.ToString(), out int gewaehlteZeile)) return;

        aktuelleZeile = gewaehlteZeile;
        using var ms = new MemoryStream(originalDateiBytes);
        using var workbook = new XLWorkbook(ms);
        var sheet = ExcelSvc.GetArbeitsblatt(workbook, aktuellesBlattName);

        felder = ExcelSvc.LeseZeilenFelder(sheet, aktuelleZeile, steuerung);
    }

    private string GeneriereZielDateiname() => $"Erf_Energie_{DateTime.Now:yyMMdd}.xlsx";

    private async Task Speichern()
    {
        if (originalDateiBytes == null) return;

        originalDateiBytes = ExcelSvc.SchreibeZeile(originalDateiBytes, aktuellesBlattName, aktuelleZeile, felder, steuerung);

        if (!string.IsNullOrEmpty(googleToken) && !string.IsNullOrEmpty(aktuelleDriveDateiId))
        {
            statusText = "Speichere direkt auf Google Drive...";
            var res = await DriveService.UeberschreibeDateiAsync(googleToken, aktuelleDriveDateiId, originalDateiBytes);

            if (res.Erfolg)
            {
                statusText = $"ERFOLG! Zeile {aktuelleZeile} wurde sauber in {geladenerDateiName} auf Google Drive gespeichert.";
                return;
            }
            statusText = $"Google Drive Fehler ({res.Fehler}) – starte lokalen Notfall-Download...";
        }

        using var outStream = new MemoryStream(originalDateiBytes);
        using var streamRef = new DotNetStreamReference(outStream);
        await JS.InvokeVoidAsync("downloadFileFromStream", GeneriereZielDateiname(), streamRef);
    }
}
